void MaDriveAudioProcessorEditor::paint(juce::Graphics&g){int w=getWidth(),h=getHeight(),pw=juce::jlimit(225,270,w/4),lx=20,rx=w-pw-20,cx=lx+pw+14,cw=juce::jmax(260,rx-cx-14);g.fillAll(juce::Colour(0xff777168));auto o=getLocalBounds().reduced(12);g.setColour(juce::Colour(0xff121313));g.fillRoundedRectangle(o.toFloat(),12);g.setColour(juce::Colour(0xff777168));g.fillRoundedRectangle(o.reduced(10).toFloat(),8);g.setColour(juce::Colours::black);g.fillRect(juce::Rectangle<int>(cx,100,cw,h-145));g.setColour(juce::Colours::white);g.setFont(juce::FontOptions(32).withStyle("Bold"));g.drawText("Ma Drive",0,15,w,42,juce::Justification::centred);g.setFont(juce::FontOptions(12));g.drawText("WADIDAW / SATURATION / CLIPPER",0,53,w,20,juce::Justification::centred);g.drawText("SOFT CLIP",lx,82,pw,22,juce::Justification::centred);g.drawText("DRIVE",rx,82,pw,22,juce::Justification::centred);auto gr=juce::Rectangle<float>((float)cx,145,(float)cw,(float)juce::jmax(235,h-330));g.setColour(juce::Colours::darkgrey);for(int z=1;z<8;++z)g.drawHorizontalLine((int)(gr.getY()+z*gr.getHeight()/8),gr.getX(),gr.getRight());juce::Path ip,op;int q=p.historyWrite.load();for(int z=0;z<256;++z){int j=(q+z)&255;float x=gr.getX()+gr.getWidth()*z/255.f,y=gr.getCentreY()-p.inputHistory[j]*gr.getHeight()*.28f,v=gr.getCentreY()-p.outputHistory[j]*gr.getHeight()*.28f;if(!z){ip.startNewSubPath(x,y);op.startNewSubPath(x,v);}else{ip.lineTo(x,y);op.lineTo(x,v);}}g.setColour(juce::Colours::whitesmoke);g.strokePath(ip,juce::PathStrokeType(1.3f));g.setColour(juce::Colour(0xfff3372f));g.strokePath(op,juce::PathStrokeType(2));float th=juce::jlimit(-24.f,0.f,p.thresholdForDisplay.load()),ty=gr.getY()-th/24.f*gr.getHeight();const float ds[]={5,4};g.setColour(juce::Colour(0xffff8a2a));g.drawDashedLine({gr.getX(),ty,gr.getRight(),ty},ds,2,2);g.setFont(juce::FontOptions(11));g.drawText("THRESHOLD "+juce::String(th,1)+" dB",cx+6,(int)ty-17,150,16,juce::Justification::left);int mode=(int)p.parameters.getRawParameterValue("p